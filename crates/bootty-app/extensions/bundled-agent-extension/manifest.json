{
  "schema_version": 1,
  "extension_id": "bootty.agents",
  "name": "Bundled agent orchestration",
  "runtime": "luau",
  "entrypoint": "agent_extension.luau",
  "storage_namespace": "agents",
  "generation": "host-assigned",
  "event_topics": ["agents.changed"],
  "commands": [
    "agents.abort",
    "agents.clear_authority",
    "agents.explain",
    "agents.focus",
    "agents.get",
    "agents.ingest",
    "agents.integration.doctor",
    "agents.integration.install",
    "agents.integration.list",
    "agents.integration.setup",
    "agents.integration.uninstall",
    "agents.list",
    "agents.manifest.list",
    "agents.manifest.reload",
    "agents.pause",
    "agents.prompt",
    "agents.read",
    "agents.release",
    "agents.rename",
    "agents.report",
    "agents.report_session",
    "agents.resume",
    "agents.retry",
    "agents.send_keys",
    "agents.send_text",
    "agents.start",
    "agents.view.clear",
    "agents.view.set",
    "agents.wait"
  ],
  "adapters": ["pi", "claude", "codex", "opencode"],
  "limits": {
    "max_event_bytes": 1048576,
    "max_output_bytes": 262144,
    "max_pending_events": 1024
  }
}
