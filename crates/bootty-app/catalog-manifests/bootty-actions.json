{
  "schema_version": 1,
  "manifest": "bootty_actions",
  "source": "Bootty action catalog, executable keybindings, and registry-injected aliases",
  "source_path": "crates/bootty-app/src/action_catalog.rs; crates/bootty-app/src/app_actions.rs; crates/bootty-app/src/commands.rs",
  "entries": [
