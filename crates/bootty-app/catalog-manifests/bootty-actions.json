      "kind": "alias",
      "command": "terminal.scroll.page_down"
    },
    {
      "id": "scroll_page_lines",
      "kind": "alias",
      "command": "terminal.scroll.lines"
    },
    {
      "id": "scroll_page_up",
      "kind": "alias",
      "command": "terminal.scroll.page_up"
    },
    {
      "id": "scroll_to_bottom",
      "kind": "alias",
      "command": "terminal.scroll.bottom"
    },
    {
      "id": "scroll_to_top",
      "kind": "alias",
      "command": "terminal.scroll.top"
    },
    {
      "id": "search",
      "kind": "alias",
      "command": "terminal.search"
    },
    {
      "id": "search_selection",
      "kind": "alias",
      "command": "terminal.search.selection"
    },
    {
      "id": "select_pane",
      "kind": "alias",
      "command": "pane.focus_direction"
    },
    {
      "id": "select_session",
      "kind": "alias",
      "command": "session.select"
    },
    {
      "id": "select_space",
      "kind": "alias",
      "command": "space.select"
    },
    {
      "id": "select_tab",
      "kind": "alias",
      "command": "window.select"
    },
    {
      "id": "session_picker",
      "kind": "alias",
      "command": "session.picker"
    },
