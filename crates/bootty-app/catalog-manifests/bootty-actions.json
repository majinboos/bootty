      "id": "change_appearance",
      "kind": "alias",
      "command": "appearance.set"
    },
    {
      "id": "close_space",
      "kind": "alias",
      "command": "space.close"
    },
    {
      "id": "close_surface",
      "kind": "alias",
      "command": "pane.close"
    },
    {
      "id": "close_window",
      "kind": "alias",
      "command": "app.window.close"
    },
    {
